# ───────────────────────── LÚMINA · variables de entorno ─────────────────────────
# Copia este archivo como .env.local para desarrollo. Nunca subas .env.local al repositorio.

# URL pública del sitio: canonical, Open Graph, sitemap y robots. En producción usa https://
SITE_URL=http://localhost:3000

# Base de datos libSQL/SQLite.
# Local: archivo SQLite autocontenido (se crea con pnpm db:setup).
# Producción: una base durable administrada, p. ej. Turso (libsql://<db>-<org>.turso.io) + token.
DATABASE_URL=file:./data/lumina.db
DATABASE_AUTH_TOKEN=

# Número de WhatsApp de la empresa: solo dígitos con indicativo de país (Colombia: 57 + celular).
# Vacío = el botón de WhatsApp no se muestra.
WHATSAPP_BUSINESS_NUMBER=

# Administración (/admin). Sin ADMIN_EMAIL y ADMIN_PASSWORD_HASH el panel queda deshabilitado:
# no existe contraseña por defecto. Genera el hash con:
#   pnpm admin:hash "una-contraseña-larga-y-única"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Protección anti-spam de formularios (por cliente y ventana en segundos) y del login.
FORM_RATE_LIMIT_MAX=5
FORM_RATE_LIMIT_WINDOW_SECONDS=900
FORM_GLOBAL_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
